{
  "name": "playwright-shop-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright web and API automation framework for the QA Electronics practice shop",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web-chromium",
    "test:api": "playwright test --project=api",
    "test:ci": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "typescript": "^5.9.3"
  }
}
