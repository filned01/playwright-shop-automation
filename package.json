{
  "name": "playwright-shop-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright web and API automation framework for the QA Electronics practice shop",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:web:chromium": "playwright test --project=web-chromium",
    "test:api": "playwright test --project=api",
    "test:ci": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"playwright.config.ts\" \"tests/**/*.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\" \".github/workflows/playwright.yml\"",
    "format:check": "prettier --check \"playwright.config.ts\" \"tests/**/*.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\" \".github/workflows/playwright.yml\"",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
